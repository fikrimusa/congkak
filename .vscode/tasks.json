{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Generate build files with Debug + compile_commands.json"
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "-j"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "cmake: configure",
            "problemMatcher": ["$gcc"],
            "detail": "Build the project (configures first if needed)"
        },
        {
            "label": "cmake: clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "clean: wipe build dir",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "build"],
            "problemMatcher": []
        },
        {
            "label": "format: clang-format all",
            "type": "shell",
            "command": "find",
            "args": [
                "src",
                "-type", "f",
                "(", "-name", "*.cpp", "-o", "-name", "*.hpp", "-o", "-name", "*.h", ")",
                "-exec", "clang-format", "-i", "{}", "+"
            ],
            "problemMatcher": [],
            "detail": "Format every C/C++ source file under src/ in place"
        }
    ]
}
